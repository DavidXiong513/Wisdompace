# Supabase — 用户认证 + 数据存储
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 站点 URL — 邮箱验证链接、密码重置链接等需要用到
# 生产环境必须设置为 https://www.wisdompace.com
# 本地开发可省略（默认 http://localhost:3000）
NEXT_PUBLIC_SITE_URL=

# Resend — 邮件发送（推荐，Vercel 兼容，免费100封/月）
# 注册: https://resend.com → 获取 API Key → 验证发件域名
RESEND_API_KEY=
RESEND_FROM=Wisdompace <onboarding@resend.dev>
MAIL_TO=1318952797@qq.com

# QQ 邮箱 SMTP — 本地开发备用（Vercel Serverless 不兼容）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
